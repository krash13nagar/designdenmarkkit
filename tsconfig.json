{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "target": "es5",
    "sourceMap": true,
    "jsx": "react",
    "esModuleInterop": true,
    "allowJs": true,
    "moduleResolution": "node",
    "lib": ["es6", "dom", "dom.iterable", "esnext"],
    "types": ["node", "@types/babel__core"],
    "declaration": true
  },
  "include": ["src", ".storybook", "declaration.d.ts"],
  "exclude": ["node_modules"]
}
