{
  "name": "@denui/denmark-ui-components",
  "version": "1.0.115",
  "private": false,
  "description": "Denmark | Common design library based on React and Material UI",
  "main": "index.tsx",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "webpack --config config/webpack.prod.js",
    "start": "webpack serve --config config/webpack.start.js --port 3100",
    "format": "prettier --write \"src/**/*.tsx\"",
    "babelbuild": "babel src -d build",
    "build-storybook": "storybook build",
    "publish:npm": "rm -rf dist && mkdir dist &&  babel src/components -d dist --copy-files",
    "clean": "rm -rf dist",
    "prebuildpackage": "npm run clean && npm run build && node SetupPackage.js",
    "localunpublish": "npm unpublish  --registry http://localhost:4873/ @denui/denmark-ui-components --force",
    "localpublish": "npm run prebuildpackage && cd dist && npm publish --registry http://localhost:4873",
    "prodpublish": "npm run prebuildpackage && cp .npmrc dist/ && cd dist && npm publish"
  },
  "keywords": [],
  "author": "sandeep.guddu@gmail.com",
  "license": "ISC",
